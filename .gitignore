# ---------- deps ----------
node_modules/
.pnpm-store/
.yarn/
vendor/

# ---------- build output ----------
dist/
build/
out/
.next/
.nuxt/
.vite/
.turbo/
.parcel-cache/
storybook-static/
*.tsbuildinfo
*.map

# ---------- env / secrets ----------
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
*.p12

# ---------- local-first user data (never commit) ----------
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
recordings/
uploads/

# ---------- local service state ----------
.temporal/
temporal.db
.pgdata/
postgres-data/

# ---------- models (large, re-downloadable) ----------
models/
*.gguf
*.onnx

# ---------- test / capture artifacts ----------
coverage/
test-results/
playwright-report/
.chrome-profile/
playwright/.cache/

# ---------- python (scripts / landing) ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- logs / tmp ----------
*.log
*.pid
*.tmp
*.bak
tmp/

# ---------- editor / os ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# ---------- allowlist: deliberately committed ----------
# The screenshots and the sample-data fixture are evidence, so they stay even
# though the patterns above would otherwise be broad enough to swallow them.
!docs/media/
!fixtures/
