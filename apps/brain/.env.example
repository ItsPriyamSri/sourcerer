# ─────────────────────────────────────────────────────────────────────────────
# Sourcerer brain — environment
#
# Everything is OPTIONAL. With zero keys and no network the brain still runs
# end-to-end on local Gemma + local heuristics. Each key below upgrades one
# capability; GET /capabilities reports which are live.
# Copy to .env and fill in what you have.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
# Comma-separated origins allowed to call the brain (the web app).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Local open-weight model (Gemma 3 via Ollama) — the default brain ─────────
# Start Ollama, then: pnpm model:pull
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Text-only fallback if the multimodal model is not pulled (faster on CPU).
OLLAMA_TEXT_MODEL=gemma3:1b
# The agent loop needs tool calling, and Ollama's Gemma 3 does not offer it
# (`completion, vision` only). A small tool-capable open model stands in.
# Deliberately not a reasoning model: a thinking model spends thousands of tokens
# deliberating over a protocol that a plain instruct model just follows.
OLLAMA_TOOL_MODEL=llama3.2:3b
# Embeddings for similar-item search (optional).
OLLAMA_EMBED_MODEL=nomic-embed-text
# Pins Ollama's sampler for every local call. Leave it unset for real behaviour:
# a fresh random seed per request. `scripts/capture-evidence.ts` needs it set (7)
# so two captures produce the same frames, because the model's read of an item
# decides which comparables match and therefore what the price is.
# OLLAMA_SEED=7

# ── Backboard (hosted open-weight models through one key) ────────────────────
# The demo/cloud brain path. Same agent, open-weight models, no GPU.
# https://app.backboard.io  → docs.backboard.io
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_LLM_PROVIDER=openrouter
BACKBOARD_MODEL=google/gemma-3-27b-it
# Force which provider serves the model: `ollama` or `backboard`. Leave blank to
# choose automatically (local unless PREFER_BACKBOARD=1 and a Backboard key exists).
MODEL_PROVIDER=
# Prefer Backboard whenever a Backboard key is present, instead of local Gemma.
PREFER_BACKBOARD=0

# ── Live market prices (SerpApi) ─────────────────────────────────────────────
# Grounds pricing in fresh eBay listings. Without it the app stays fully offline.
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=
# SerpApi only accepts 25, 50, 100 or 200 here; anything between snaps up to the next
# allowed size, so 60 would become 100. Each search costs one credit.
SERPAPI_MAX_RESULTS=100

# ── Local price model (TabPFN / Prior Labs) ──────────────────────────────────
# Learns YOUR sold history and predicts price + days-to-sell offline.
# Free non-commercial key: https://platform.priorlabs.ai/account/api-keys
# The REST flow is not a single train call. It is: /tabpfn/prepare_train_set_upload
# → PUT the signed URLs → /tabpfn/fit → /tabpfn/prepare_test_set_upload → PUT →
# /tabpfn/predict. The app fits once per change to your history, then reuses it.
# The bundled demo fixture (fixtures/sold.json) holds 32 seeded historical sales —
# sample data, not real market data — which is plenty to fit.
TABPFN_TOKEN=
TABPFN_MODEL_PATH=v3.5_default
TABPFN_BASE_URL=https://api.priorlabs.ai

# ── Vector memory (Tiger Data / pgvector) ────────────────────────────────────
# "have I bought this before?" + similar-item retrieval.
# Tiger Data: postgresql://tsdbadmin:...@<svc>.<proj>.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
# Local fallback: pnpm db:up  → postgres://postgres:postgres@localhost:5432/sourcerer
DATABASE_URL=
EMBED_DIM=768

# ── Durability (Temporal) ────────────────────────────────────────────────────
# Nightly reprice job that survives crashes and retries flaky search calls.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sourcerer-reprice

# ── Voice (ElevenLabs) ───────────────────────────────────────────────────────
# Dictate an item while both hands are full; hear the verdict hands-free.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_VOICE=21m00Tcm4TlvDq8ikWAM

# ── Tracing (Sentry) — auto-instruments Mastra agents ────────────────────────
# https://docs.sentry.io/platforms/javascript/guides/node/agent-tracing/
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
# Keep photo bytes out of traces. Set to 1 only when debugging locally.
SENTRY_RECORD_INPUTS=0

# ── Local data ───────────────────────────────────────────────────────────────
# Inventory + captured photos never leave this machine.
SOURCERER_DATA_DIR=./data
