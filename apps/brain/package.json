    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "ai": "latest",
    "hono": "^4.9.0",
    "nanoid": "^5.1.0",
    "ollama-ai-provider-v2": "latest",
