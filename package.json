{
  "name": "sourcerer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "protobufjs",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver",
      "bufferutil",
      "utf-8-validate"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "build": "pnpm --filter \"./packages/**\" build && pnpm --filter \"./apps/web\" build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "model:pull": "bash scripts/pull-model.sh",
    "db:up": "bash scripts/db-up.sh",
    "evidence:identify": "pnpm --filter @sourcerer/brain exec tsx eval/run-identify.ts",
    "evidence:memory": "pnpm --filter @sourcerer/brain exec tsx eval/run-memory.ts",
    "evidence:capture": "tsx scripts/capture-evidence.ts",
    "landing": "python3 -m http.server 4173 --directory landing"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "playwright": "^1.56.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
