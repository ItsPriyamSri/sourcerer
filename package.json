{
  "name": "sourcerer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "protobufjs",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver",
      "bufferutil",
      "utf-8-validate"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "build": "pnpm --filter \"./packages/**\" build && pnpm --filter \"./apps/web\" build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "model:pull": "bash scripts/pull-model.sh",
    "db:up": "bash scripts/db-up.sh"
  }
}
