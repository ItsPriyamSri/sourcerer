# The brain, containerised.
#
# Deliberately a *runtime* image (tsx, source, no build step): the API is TypeScript
# that Node runs directly, and a 3-second cold start beats a 200 MB bundling step for
# a service that is meant to feel instant.
#
# Note what is NOT in here: no model weights. Gemma runs in Ollama on the host (or is
# reached through Backboard when hosted). Shipping 3 GB of weights inside an HTTP
# service would be the wrong architecture, and it would not fit a free tier anyway.

FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /app

# The workspace manifests first, so dependency layers cache across code changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY apps/brain/package.json apps/brain/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --prod=false --filter @sourcerer/brain...

COPY packages/shared packages/shared
COPY apps/brain apps/brain

ENV NODE_ENV=production
ENV PORT=8787
ENV SOURCERER_DATA_DIR=/var/data
RUN mkdir -p /var/data

EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
  CMD wget -qO- http://127.0.0.1:8787/health || exit 1

WORKDIR /app/apps/brain
CMD ["pnpm", "exec", "tsx", "src/index.ts"]
